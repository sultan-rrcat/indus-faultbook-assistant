APP_ENV=dev
CORS_ORIGINS=http://localhost:5173

DB_HOST=localhost
# DB_PORT is optional. Unset = Shared Memory for a local default instance.
# Set DB_PORT=1433 to force TCP.
# DB_PORT=1433
DB_NAME=SRS_flogbook
DB_USERNAME=sa
DB_PASSWORD=YOUR_DB_PASSWORD
DB_TRUST_SERVER_CERT=true
DB_TIMEOUT_SECONDS=15

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120000
OLLAMA_MODEL=lfm3:latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional HTTP(S) proxy for Gemini (standard variables are picked up too).
# Include credentials URL-encoded, e.g. http://user:p%40ss@proxy.local:3128
# Ollama traffic always bypasses the proxy.
# HTTPS_PROXY=
# HTTP_PROXY=
